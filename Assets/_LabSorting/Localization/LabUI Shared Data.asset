    m_Key: Find an empty rack on this floor, or one holding the same item.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039285
    m_Key: Pick up another item first.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039286
    m_Key: Tap DROP to throw one item gently forward.
    m_Metadata:
      m_Items: []

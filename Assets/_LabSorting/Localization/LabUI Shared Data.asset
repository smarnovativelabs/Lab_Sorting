    m_Key: TOOLS & REWARDS
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039304
    m_Key: SEARCH and MAGNET use your selected category anywhere in the lab. Full
      hands never charge for magnet.
    m_Metadata:
      m_Items: []

    m_Metadata:
      m_Items: []
  - m_Id: 5182701571
    m_Localized: "Estante vac\xEDo: coloca el objeto seleccionado"
    m_Metadata:
      m_Items: []
  - m_Id: 5111398407
    m_Localized: Estante lleno
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039247
    m_Localized: Tipo incorrecto
    m_Metadata:
      m_Items: []
  - m_Id: 5111398408
    m_Localized: No cabe en este estante
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039248
    m_Localized: Este estante contiene
    m_Metadata:
      m_Items: []
  - m_Id: 5077843973
    m_Localized: Primero selecciona un objeto de tu inventario
    m_Metadata:
      m_Items: []
  - m_Id: 5077843974
    m_Localized: "La b\xFAsqueda ya est\xE1 activa: sin coste"
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039249
    m_Localized: No quedan objetos sueltos de tipo
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039250
    m_Localized: 'sin recoger: sin coste'
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039251
    m_Localized: 'disponibles: sin coste'
    m_Metadata:
      m_Items: []
  - m_Id: 5077843977
    m_Localized: "Consigue b\xFAsquedas con dinero, un anuncio o en la tienda"
    m_Metadata:
      m_Items: []
  - m_Id: 5077843987
    m_Localized: Consigue imanes con dinero, un anuncio o en la tienda
    m_Metadata:
      m_Items: []
  - m_Id: 5077843992
    m_Localized: Consigue un espacio con dinero, un anuncio o en la tienda
    m_Metadata:
      m_Items: []
  - m_Id: 5077843981
    m_Localized: "Inventario lleno: no se cobra el im\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 5077843984
    m_Localized: 'Espera a terminar de recoger: sin coste'
    m_Metadata:
      m_Items: []
  - m_Id: 5077843988
    m_Localized: "No se recogi\xF3 nada: sin coste"
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039252
    m_Localized: RECOGIDOS
    m_Metadata:
      m_Items: []
  - m_Id: 5077843986
    m_Localized: SIN COINCIDENCIAS
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039253
    m_Localized: "El im\xE1n recogi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 5077843991
    m_Localized: "Capacidad m\xE1xima alcanzada: sin coste"
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039254
    m_Localized: Capacidad ampliada a
    m_Metadata:
      m_Items: []
  - m_Id: 5098815499
    m_Localized: Dinero insuficiente
    m_Metadata:
      m_Items: []
  - m_Id: 5103009794
    m_Localized: Progreso guardado
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039255
    m_Localized: "Guardado pendiente. Reintentando; mant\xE9n el juego abierto."
    m_Metadata:
      m_Items: []
  - m_Id: 5111398400
    m_Localized: No hay objetos al alcance
    m_Metadata:
      m_Items: []
  - m_Id: 5111398401
    m_Localized: 'Inventario lleno: coloca o suelta un objeto'
    m_Metadata:
      m_Items: []

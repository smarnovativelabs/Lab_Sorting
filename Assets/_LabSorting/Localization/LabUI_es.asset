      m_Items: []
  - m_Id: 8216963039325
    m_Localized: Compra cancelada o fallida.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039326
    m_Localized: "Compra pendiente de aprobaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039327
    m_Localized: Compra entregada.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039328
    m_Localized: "Confirmaci\xF3n de compra pendiente."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039329
    m_Localized: No se pudieron restaurar las compras pendientes.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039330
    m_Localized: Entrega de compra pendiente.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039331
    m_Localized: "Anuncios eliminados. Los v\xEDdeos con recompensa siguen disponibles."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039332
    m_Localized: "Guardando la compra. Se reintentar\xE1 la entrega."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039333
    m_Localized: "Verificaci\xF3n pendiente. Int\xE9ntalo m\xE1s tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039334
    m_Localized: Abriendo la tienda...
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039335
    m_Localized: "No hay v\xEDdeos disponibles o la capacidad est\xE1 llena."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039336
    m_Localized: "Reproduciendo el v\xEDdeo..."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039337
    m_Localized: "V\xEDdeo no disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 5040095239
    m_Localized: "\xA1Recompensa a\xF1adida!"
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039338
    m_Localized: Guardando la recompensa. Espera.
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039339
    m_Localized: "V\xEDdeo cerrado. Debes terminarlo para recibir la recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 8216963039340
    m_Localized: "No se pudo reproducir el v\xEDdeo. No se consumi\xF3 ninguna recompensa."
    m_Metadata:
      m_Items: []
